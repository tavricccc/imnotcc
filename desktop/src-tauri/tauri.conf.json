{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cc-remote",
  "version": "0.1.0",
  "identifier": "dev.ccremote.desktop",
  "build": {
    "frontendDist": "../src",
    "beforeBuildCommand": "npm --prefix .. run build"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": {
      "../../server/": "server-app/server/",
      "../../dist/": "server-app/dist/",
      "../../package.json": "server-app/package.json",
      "../../package-lock.json": "server-app/package-lock.json"
    },
    "windows": {
      "nsis": { "installMode": "currentUser", "languages": ["TradChinese", "English"] }
    }
  }
}
